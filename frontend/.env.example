VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_BASE_URL=http://localhost:8000
# Public half of the backend's LLM_SETTINGS_PRIVATE_KEY keypair (see
# backend/app/agent/crypto.py) -- not secret, used to sealed-box-encrypt
# a user's LLM provider API key client-side before it's written to
# llm_settings.api_key_encrypted.
VITE_LLM_SETTINGS_PUBLIC_KEY=your-public-key
